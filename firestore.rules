rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserProfile().role == role;
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isHospitalAdmin() {
      return isSuperAdmin() || hasRole('hospital_admin');
    }

    function isReceptionist() {
      return isSuperAdmin() || hasRole('receptionist');
    }

    function isAccountant() {
      return isSuperAdmin() || hasRole('accountant');
    }

    function isHrManager() {
      return isSuperAdmin() || hasRole('hr_manager');
    }

    function isDoctor() {
      return hasRole('doctor');
    }

    // 1. User Profiles & Roles
    match /userProfiles/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // 2. Hospital Settings (Global)
    match /hospitalSettings/{docId} {
      allow read: if true; // Public website needs contact, branding, opening hours
      allow write: if isSuperAdmin() || isHospitalAdmin();
    }

    // 3. Clinical Departments & Services
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isHospitalAdmin();
    }
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isHospitalAdmin();
    }

    // 4. Doctors & Weekly Schedules
    match /doctors/{doctorId} {
      allow read: if true; // Public needs to view doctors & availability
      allow write: if isHospitalAdmin() || (isDoctor() && getUserProfile().doctorId == doctorId);
    }
    match /doctorSchedules/{scheduleId} {
      allow read: if true;
      allow write: if isHospitalAdmin() || isDoctor();
    }

    // 5. Patient Appointments
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        isHospitalAdmin() || 
        isReceptionist() || 
        isAccountant() || 
        (isDoctor() && resource.data.doctorId == getUserProfile().doctorId)
      );
      // Public website can create appointment, admin/receptionist can manage
      allow create: if true;
      allow update: if isAuthenticated() && (isHospitalAdmin() || isReceptionist() || isDoctor() || isAccountant());
      allow delete: if isSuperAdmin();
    }

    // 6. Bank Transfer Payment Submissions
    match /paymentSubmissions/{submissionId} {
      // Patients can submit bank transfer receipt from public website
      allow create: if true;
      // Verification queue is strictly restricted to Accountant & Super Admin
      allow read, update: if isAuthenticated() && (isAccountant() || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // 7. Payment Ledger & Daily Collections
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (isAccountant() || isSuperAdmin() || isReceptionist());
      allow create, update: if isAuthenticated() && (isAccountant() || isSuperAdmin() || isReceptionist());
      allow delete: if false; // Immutable ledger
    }

    // 8. Hospital Operating Expenses
    match /expenses/{expenseId} {
      allow read, write: if isAuthenticated() && (isAccountant() || isSuperAdmin());
    }

    // 9. Doctor & Staff Payroll Records (Strictly Confidential)
    match /salaryRecords/{salaryId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isAccountant() || isHrManager());
      allow write: if isAuthenticated() && (isSuperAdmin() || isAccountant() || isHrManager());
    }

    // 10. Staff Directory
    match /staff/{staffId} {
      // Internal staff directory
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isHrManager();
    }

    // 11. Website Banners, Popups & Announcements
    match /banners/{bannerId} {
      allow read: if true; // Public website
      allow write: if isHospitalAdmin();
    }
    match /announcements/{announcementId} {
      allow read: if true; // Public website
      allow write: if isHospitalAdmin();
    }

    // 12. Security Audit Logs
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || isHospitalAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }

    // 13. Notifications
    match /notifications/{notifId} {
      allow read, update: if isAuthenticated();
      allow create: if true;
    }
  }
}
